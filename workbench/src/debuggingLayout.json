{
    "title": "Debugging Layout",
    "layoutRoot": "root",
    "containers": {
        "root": {
            "id": "root",
            "type": "split",
            "orientation": "vertical",
            "children": [
                {
                    "containerId": "menuBar",
                    "type": "container",
                    "size": { 
                        "initial": { "value": 37, "unit": "px", "type": "fixed" }
                    }
                },
                {
                    "containerId": "mainBody",
                    "type": "container",
                    "size": { "initial": { "type": "fill" }}
                },
                {
                    "containerId": "footer",
                    "type": "container",
                    "size": { "initial": { "value": 25, "unit": "px", "type": "fixed" }},
                    "collapse": { "value": 400, "condition": "lessThan", "relative": "parent" }
                }
            ]
        },
        "header": {
            "id": "header",
            "background": "#3c3c3c"
        },
        "mainBody": {
            "id": "mainBody",
            "background": "#3c3c3c",
            "type": "split",
            "orientation": "horizontal",
            "children": [
                {
                    "containerId": "sidebar",
                    "type": "container",
                    "size": { "initial": { "value": 40, "unit": "px", "type": "fixed" }},
                    "collapse": { "value": 400, "condition": "lessThan", "relative": "parent" }
                },

                {
                    "containerId": "behaviorAnalaysisContainer",
                    "type": "container",
                    "size": { 
                        "initial": { "value": 300, "unit": "px", "type": "fixed" },
                        "min": { "value": 50, "unit": "px"}
                    }
                },
                {
                    "type": "handleBar",
                    "sibling1": "behaviorAnalaysisContainer",
                    "sibling2": "contentContainer"
                },

                {
                    "containerId": "contentContainer",
                    "type": "container",
                    "size": { 
                        "initial": { "value": 500, "unit": "px", "type": "fixed" },
                        "min": { "value": 50, "unit": "px"}
                    }
                },
                {
                    "type": "handleBar",
                    "sibling1": "contentContainer",
                    "sibling2": "transformOutputMetadataContainer"
                },
                {
                    "containerId": "transformOutputMetadataContainer",
                    "type": "container",
                    "size": { "initial": { "type": "fill" }}
                }
            ]
        },
        "contentContainer": {
            "id": "contentContainer",
            "background": "#3c3c3c",
            "type": "split",
            "orientation": "vertical",
            "children": [
                {
                    "containerId": "body",
                    "type": "container",
                    "size": { "initial": { "type": "fill" }}
                },
                {
                    "type": "handleBar",
                    "sibling1": "body",
                    "sibling2": "transformationLogContainer"
                },
                {
                    "containerId": "transformationLogContainer",
                    "type": "container",
                    "size": { 
                        "initial": { "value": 300, "unit": "px", "type": "fixed" },
                        "min": { "value": 50, "unit": "px"}
                    }
                }
            ]
        },
        "transformationLogContainer": {
            "id": "transformationLogContainer",
            "type": "split",
            "orientation": "horizontal",
            "children": [
                {
                    "containerId": "behaviorScriptContainer",
                    "type": "container",
                    "size": { "initial": { "type": "fill" }}
                }
            ],
            "background": "#252526"
        },
        "traceViewer": {
            "id": "traceViewer",    
            "component":"TraceSelector",
            "background": "#252526"
        },
        "terminal": {
            "id": "terminal",
            "tabsBar": {
                "tabs": [
                    {
                        "name": "Terminal",
                        "component": "PtyTerminal"
                    }
                ],
                "showClose": true,
                "closeContainerId": "terminalContainer"
            },
            "background": "#252526"
        },
        "body": {
            "id": "body",
            "type": "split",
            "orientation": "vertical",
            "children": [
                {
                    "containerId": "content",
                    "type": "container",
                    "size": { "initial": { "type": "fill" }}
                }
            ]
        },
        "content": {
            "id": "content",
            "background": "#007acc",
            "type": "split",
            "orientation": "vertical",
            "children": [
                {
                    "containerId": "topContent",
                    "type": "container",
                    "size": { "initial": { "type": "fill" }}
                },
                {
                    "type": "handleBar",
                    "sibling1": "topContent",
                    "sibling2": "bottomContent"
                },
                {
                    "containerId": "bottomContent",
                    "type": "container",
                    "size": { "initial": { "type": "fill" }}
                }
            ]
        },
        "topContent": {
            "id": "topContent",
            "background": "#007acc",
            "type": "split",
            "orientation": "horizontal",
            "children": [
                {
                    "containerId": "initialArgs",
                    "type": "container",
                    "size": { "initial": { "type": "fill" }}
                },
                {
                    "type": "handleBar",
                    "sibling1": "initialArgs",
                    "sibling2": "preWorldStateContainer"
                },
                {
                    "containerId": "preWorldStateContainer",
                    "type": "container",
                    "size": { "initial": { "type": "fill" }}
                }
            ]
        },
        "bottomContent": {
            "id": "bottomContent",
            "background": "#007acc",
            "type": "split",
            "orientation": "horizontal",
            "children": [
                {
                    "containerId": "expectedPostWorldStateEditor",
                    "type": "container",
                    "size": { "initial": { "type": "fill" }}
                },
                {
                    "type": "handleBar",
                    "sibling1": "expectedPostWorldStateEditor",
                    "sibling2": "outputContainer"
                },
                {
                    "containerId": "outputContainer",
                    "type": "container",
                    "size": { "initial": { "type": "fill" }}
                }
            ]
        },
        
        "transformOutputMetadataContainer": {
            "id": "transformOutputMetadataContainer",
            "background": "#252526",
            "component": "DebuggerTransformOutputMetadata", 
            "menuBar": {
                "showClose": false,
                "title": "Transform Metadata"
            }
        },
        "behaviorAnalaysisContainer": {
            "id": "behaviorAnalaysisContainer",
            "background": "#007acc",
            "type": "split",
            "orientation": "vertical",
            "children": [
                {
                    "containerId": "traceBehaviorContainer",
                    "type": "container",
                    "size": { "initial": { "type": "fill" }}
                },
                {
                    "type": "handleBar",
                    "sibling1": "traceBehaviorContainer",
                    "sibling2": "rootCauseContainer"
                },
                {
                    "containerId": "rootCauseContainer",
                    "type": "container",
                    "size": { "initial": { "type": "fill" }}
                }
            ]
        },
        "traceBehaviorContainer": {
            "id": "traceBehaviorContainer",
            "component": "TraceBehaviorSelector",
            "menuBar": {
                "showClose": false,
                "title": "Behavior Inspector"
            },
            "background": "#1e1e1e"
        },
        "rootCauseContainer": {
            "id": "rootCauseContainer",
            "component": "RootCauseContainer",
            "menuBar": {
                "showClose": false,
                "title": "Root Cause(s)"
            },
            "background": "#1e1e1e"
        },
        "menuBar": {
            "id": "menuBar",
            "component": "DebuggingToolBar",
            "background": "#4f3b55"
        },
        "footer": {
            "id": "footer",
            "component": "StatusBar",
            "background": "#007acc"
        },
        "sidebar": {
            "id": "sidebar",
            "component": "SideBarMenu",
            "background": "#333"
        },
        "initialArgs": {
            "id": "initialArgs",
            "component": "DebuggerBehaviorInitialArgs",
            "menuBar": {
                "showClose": false,
                "title": "Arguments"
            },
            "background": "#222222"
        },
        "preWorldStateContainer": {
            "id": "preWorldStateContainer",
            "component": "DebuggerBehaviorInitialWorldState",
            "menuBar": {
                "showClose": false,
                "title": "Initial World State"
            },
            "background": "#222222"
        },
        "expectedPostWorldStateEditor": {
            "id": "expectedPostWorldStateEditor",
            "component": "DebuggerBehaviorExpectedPostWorldState",
            "menuBar": {
                "showClose": false,
                "title": "Observed Post Transform World"
            },
            "background": "#222222"
        },
        "outputContainer": {
            "id": "outputContainer",
            "component": "DebuggerBehaviorTransformOutput",
            "menuBar": {
                "showClose": false,
                "title": "Computed Post Transform World"
            },
            "background": "#222222"
        },
        "behaviorScriptContainer": {
            "id": "behaviorScriptContainer",
            "component": "DebuggerBehaviorScript",
            "menuBar": {
                "showClose": false,
                "title": "Behavior Script"
            },
            "background": "#222222"
        },
        "selectedInfoContainer": {
            "id": "selectedInfoContainer",
            "component": "SelectedInfo",
            "background": "#1e1e1e"
        },
        "participantInfoContainer": {
            "id": "participantInfoContainer",
            "component": "NodeInfo",
            "background": "#1e1e1e"
        }
    }
}